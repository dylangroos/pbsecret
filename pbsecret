#!/bin/bash
# pbsecret — pass secrets between you and an agent through the clipboard,
# without the value showing up in the agent's output.
#
#   pbsecret NAME -- cmd [args...]   clipboard -> $NAME for cmd; output masked; clipboard cleared
#   some-cmd | pbsecret --copy       stdin -> clipboard (marked concealed); prints only the byte count
#
# Guards against accidental exposure, not a hostile agent: anything that can
# run `pbpaste` can read the clipboard. Masking hides exact matches only.
set -euo pipefail

die() { echo "pbsecret: $1" >&2; exit "${2:-2}"; }

usage() {
  sed -n '5,6s/^#   //p' "$0" >&2
  exit 2
}

if [ "${1:-}" == "--copy" ]; then
  data=$(cat)
  [ -n "$data" ] || die "stdin is empty"
  # pbcopy cannot add pasteboard types. The concealed and transient markers
  # (nspasteboard.org) tell clipboard managers not to keep the item.
  printf '%s' "$data" | osascript -l JavaScript -e '
    ObjC.import("AppKit");
    function run() {
      var input = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
      var pb = $.NSPasteboard.generalPasteboard;
      pb.clearContents;
      pb.setStringForType($.NSString.alloc.initWithDataEncoding(input, $.NSUTF8StringEncoding), $.NSPasteboardTypeString);
      pb.setStringForType($(""), "org.nspasteboard.ConcealedType");
      pb.setStringForType($(""), "org.nspasteboard.TransientType");
    }' >/dev/null
  echo "copied $(printf '%s' "$data" | wc -c | tr -d ' ') bytes"
  exit 0
fi

[ $# -ge 3 ] && [ "$2" == "--" ] || usage
name=$1
shift 2
[[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name: $name"
case $name in
  PATH | IFS | DYLD_* | LD_*) die "refusing to set $name: it changes how commands load" ;;
esac
# Resolve the command now, so a typo does not use up the clipboard.
cmd=$(type -P -- "$1") || die "command not found: $1" 127

value=$(pbpaste)
value=${value%$'\r'}
[ -n "$value" ] || die "clipboard is empty"

# The masker gets the value under a fixed name and sets NAME only in the
# forked child, so NAME cannot change how the masker itself runs.
export _PBSECRET_VALUE=$value
unset value

exec perl -e '
use strict; use warnings; use IO::Select; use POSIX ();
use Time::HiRes qw(time);

my ($name, $path, @argv) = @ARGV;
my $value = delete $ENV{_PBSECRET_VALUE};

# Mask every trimmed line of 4+ characters. No part contains a newline, so a
# match never spans lines.
my %seen;
my @parts = sort { length $b <=> length $a }
  grep { length >= 4 && !$seen{$_}++ }
  map { (my $l = $_) =~ s/^\s+|\s+$//g; $l } split /\r?\n/, $value;
if (!@parts) {
  print STDERR "pbsecret: clipboard value is too short to mask (needs a line of 4+ characters)\n";
  exit 2;
}
my $re = join "|", map { quotemeta } @parts;
$re = qr/$re/;
my $maxhold = length($parts[0]) - 1;

system("pbcopy </dev/null") == 0 or print STDERR "pbsecret: could not clear the clipboard\n";

pipe(my $or, my $ow) or die "pbsecret: pipe: $!\n";
pipe(my $er, my $ew) or die "pbsecret: pipe: $!\n";
my $pid = fork // die "pbsecret: fork: $!\n";
if (!$pid) {
  close $or; close $er;
  open STDOUT, ">&", $ow or POSIX::_exit(126);
  open STDERR, ">&", $ew or POSIX::_exit(126);
  $ENV{$name} = $value;
  { no warnings "exec"; exec { $path } @argv; }
  print STDERR "pbsecret: $argv[0]: $!\n";
  POSIX::_exit(127);
}
close $ow; close $ew;
for my $sig (qw(TERM HUP INT)) { $SIG{$sig} = sub { kill $sig, $pid } }
STDOUT->autoflush(1); STDERR->autoflush(1);

my %out = (fileno($or) => \*STDOUT, fileno($er) => \*STDERR);
my %buf = map { $_ => "" } keys %out;
my $sel = IO::Select->new($or, $er);

# Length of the longest tail of $s that could start a part. That tail waits
# for the next read, so a secret split across two writes is still masked.
sub held {
  my $s = shift;
  my $max = $maxhold < length $s ? $maxhold : length $s;
  for my $k (reverse 1 .. $max) {
    my $tail = substr $s, -$k;
    return $k if grep { index($_, $tail) == 0 } @parts;
  }
  return 0;
}

sub emit {
  my ($k, $all) = @_;
  (my $s = $buf{$k}) =~ s/$re/***/g;
  my $keep = $all ? 0 : held($s);
  print { $out{$k} } substr($s, 0, length($s) - $keep);
  $buf{$k} = substr $s, length($s) - $keep;
}

sub pump {
  my $fh = shift;
  my $k = fileno $fh;
  my $n = sysread $fh, my $chunk, 65536;
  return if !defined $n && $!{EINTR};
  if (!$n) { emit($k, 1); $sel->remove($fh); close $fh; return }
  $buf{$k} .= $chunk;
  emit($k, 0);
}

my $status;
while (!defined $status) {
  if ($sel->count) {
    pump($_) for $sel->can_read(0.2);
    $status = $? if waitpid($pid, POSIX::WNOHANG()) == $pid;
  } else {
    my $r;
    do { $r = waitpid $pid, 0 } while $r == -1 && $!{EINTR};
    $status = $?;
  }
}

# The command exited. Read what it left in the pipes, but do not wait for
# background processes that still hold them open.
my $deadline = time + 0.5;
while ($sel->count && time < $deadline) {
  my @ready = $sel->can_read(0.05) or last;
  pump($_) for @ready;
}
emit($_, 1) for keys %buf;
exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
' "$name" "$cmd" "$@"
