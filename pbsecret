#!/bin/bash
# pbsecret — pass secrets between you and an agent through the clipboard,
# without the value showing up in the agent's output.
#
#   pbsecret NAME -- cmd [args...]   clipboard -> $NAME for cmd; output masked; clipboard cleared
#   some-cmd | pbsecret --copy       stdin -> clipboard; prints only the byte count
#
# Guards against accidental exposure, not a hostile agent: anything that can
# run `pbpaste` can read the clipboard. Masking hides exact matches only.
set -euo pipefail

die() { echo "pbsecret: $1" >&2; exit 2; }

usage() {
  sed -n '5,6s/^#   //p' "$0" >&2
  exit 2
}

if [ "${1:-}" == "--copy" ]; then
  data=$(cat)
  [ -n "$data" ] || die "stdin is empty"
  printf '%s' "$data" | pbcopy
  echo "copied $(printf '%s' "$data" | wc -c | tr -d ' ') bytes"
  exit 0
fi

[ $# -ge 3 ] && [ "$2" == "--" ] || usage
name=$1
shift 2
[[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name: $name"

value=$(pbpaste)
value=${value%$'\r'}
[ -n "$value" ] || die "clipboard is empty"
pbcopy </dev/null

export "$name=$value"
unset value

# Run the command with stdout and stderr each piped through a line-buffered
# masker, then exit with the command's status.
exec perl -e '
use strict; use warnings; use IO::Select; use POSIX ();

my $name = shift;
my @parts = $ENV{$name} =~ /\n/ ? () : ($ENV{$name});
for (split /\r?\n/, $ENV{$name}) { s/^\s+|\s+$//g; push @parts, $_ if length >= 4 }
my $re = join "|", map { quotemeta } sort { length $b <=> length $a } @parts;
sub mask { my $s = shift; $s =~ s/$re/***/g; $s }

pipe(my $or, my $ow) or die "pipe: $!";
pipe(my $er, my $ew) or die "pipe: $!";
my $pid = fork // die "fork: $!";
if (!$pid) {
  close $or; close $er;
  open STDOUT, ">&", $ow or POSIX::_exit(126);
  open STDERR, ">&", $ew or POSIX::_exit(126);
  { no warnings "exec"; exec { $ARGV[0] } @ARGV; }
  print STDERR "pbsecret: $ARGV[0]: $!\n";
  POSIX::_exit(127);
}
close $ow; close $ew;
STDOUT->autoflush(1); STDERR->autoflush(1);

my %out = (fileno($or) => \*STDOUT, fileno($er) => \*STDERR);
my %buf;
my $sel = IO::Select->new($or, $er);
while (my @ready = $sel->can_read) {
  for my $fh (@ready) {
    my $k = fileno $fh;
    my $n = sysread $fh, my $chunk, 65536;
    if (!$n) {
      print { $out{$k} } mask($buf{$k}) if length($buf{$k} // "");
      $sel->remove($fh); close $fh;
      next;
    }
    $buf{$k} .= $chunk;
    my $i = rindex $buf{$k}, "\n";
    print { $out{$k} } mask(substr $buf{$k}, 0, $i + 1, "") if $i >= 0;
  }
}
waitpid $pid, 0;
exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
' "$name" "$@"
